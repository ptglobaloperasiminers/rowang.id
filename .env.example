# ============================================================
# rowang.id — Environment Variables
# Copy to .env.local — NEVER commit to GitHub
# ============================================================

# Google OAuth
# console.cloud.google.com → APIs → Credentials → OAuth 2.0
# Authorized redirect URI: https://rowang.id/api/auth/callback/google
GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-XXXXXXXXX

# NextAuth — run: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-32-char-secret
NEXTAUTH_URL=https://rowang.id

# Supabase — supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xbaiomfbqsqmmmbxvdrk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=eyXXXXXXX

# Anthropic — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXX

# OpenAI Whisper — platform.openai.com → API Keys
OPENAI_API_KEY=sk-XXXXXXXXX
